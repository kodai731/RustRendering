#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#define WATER_UBO_SET 0
#define WATER_UBO_BINDING 2
#include "include/water_component.glsl"
#include "include/water_trace_payload.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba16f) uniform image2D outImage;
layout(push_constant) uniform WaterTraceFrame {
    layout(offset = 16) mat4 invViewProj;
    layout(offset = 80) vec4 cameraPos;
    layout(offset = 96) vec4 lightPos;
    layout(offset = 112) vec4 lightColor;
} frame;
layout(location = 0) rayPayloadEXT WaterTracePayload payload;

void main() {
    vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5) / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 world = frame.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 dir = normalize(world.xyz / world.w - frame.cameraPos.xyz);
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0, frame.cameraPos.xyz, 1e-3, dir, 1e30, 0);
    if (payload.exitOrigin.w < 0.5) {
        imageStore(outImage, ivec2(gl_LaunchIDEXT.xy), payload.color);
        return;
    }
    float F = payload.reflOrigin.w;
    float chord = payload.reflDir.w;
    float slopeVariance = payload.exitDir.w;
    vec3 p1 = payload.reflOrigin.xyz;
    vec3 reflDir = payload.reflDir.xyz;
    vec3 exitOrigin = payload.exitOrigin.xyz;
    vec3 exitDir = payload.exitDir.xyz;

    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0, p1 + reflDir * 1e-3, 1e-3, reflDir, 1e30, 0);
    vec3 reflection;
    if (payload.color.a > 0.5 && payload.exitOrigin.w < 0.5) {
        reflection = payload.color.rgb;
    } else {
        vec3 lightDir = normalize(frame.lightPos.xyz - p1);
        float spec = pow(max(dot(reflDir, lightDir), 0.0), 64.0 / (1.0 + 64.0 * slopeVariance));
        reflection = vec3(0.6, 0.7, 0.8) + frame.lightColor.rgb * spec;
    }

    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0, exitOrigin + exitDir * 1e-3, 1e-3, exitDir, 1e30, 0);
    vec3 background;
    if (payload.color.a > 0.5 && payload.exitOrigin.w < 0.5) {
        background = payload.color.rgb;
    } else {
        background = vec3(0.6, 0.7, 0.8);
    }

    vec3 transmission = mix(background, water.tint.rgb, clamp(water.tint.a, 0.0, 1.0)) * exp(-water.absorption.rgb * chord);
    vec3 composite = F * reflection * water.composite.x + (1.0 - F) * transmission * water.composite.y;
    imageStore(outImage, ivec2(gl_LaunchIDEXT.xy), vec4(composite, 1.0));
}
