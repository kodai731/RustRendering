# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Note: Cargo.lock is committed because this is an application, not a library
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# resource files
assets

# builds
# Note: build.rs SOURCE files are tracked. The `target/` and `debug/` rules above
# already exclude generated build artifacts; the previous bare `build.rs` pattern
# unintentionally hid actual build scripts (e.g. crates/thyllore-grpc-client/build.rs).

# cpp
src/cpp/

# editor
.idea/
.vscode/

# log
log/

# distribution packages
dist/

# lib
vendor/

# claude
.claude/settings.local.json
.claude/local

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# python parity test fixtures (generated by cargo test)
crates/thyllore-ml-core/tests/python_parity/fixtures/

# Phase 3: Python venv for gRPC stub generation (created by scripts/gen_grpc_stubs.ps1)
.venv-grpc-tools/
# Venv for scripts/collect_wheels.sh (local Linux reproduction of CI)
.venv-collect-wheels/
# Venv for the orchestrator tool-selection evaluation harness
.venv-orchestrator-eval/
# Eval run artifacts; the reported ones are archived under the design doc
scripts/orchestrator_eval/results/

# Phase 3: gRPC parity binary fixtures are vendored, but caches are not
blender_addon/tests/__pycache__/
blender_addon/grpc_client/__pycache__/
blender_addon/grpc_client/stubs/__pycache__/

# Phase 4: Ed25519 license signing private keys -- never commit
secrets/

# Phase 4: vendored wheels are populated by scripts/collect_wheels.ps1 from
# `pip download` / maturin outputs. Wheel binaries themselves and the
# host-dependent SHA256 manifest are not committed (they vary per platform
# and per build host's glibc); supply-chain integrity is delegated to pip's
# PyPI signature checks for now. Phase 6 will revisit with
# `pip --require-hashes` (see ../SharedData/document/Rust_Rendering/Design/
# 20260421_CommonaizeBlenderAddon/20260421_BlenderAddonCommonizationDesign.md).
blender_addon/wheels/*.whl
blender_addon/wheels/HASHES.txt

# Phase 4: built ZIP artifacts
blender_addon/__pycache__/
blender_addon/telemetry/__pycache__/
blender_addon/wheels-extracted/
src/ml/worker/.local/
src/ml/worker/.workerd.local.capnp
blender_addon/operators/__pycache__/
blender_addon/modal/__pycache__/
blender_addon/panels/__pycache__/

# Blender Scene (keep the docker harness tracked)
blender/*
!blender/docker/

# build outputs
release/
target-linux/
**/dist-linux/
dist/.last_built_zip

# CI parity test fixtures (regenerated from ONNX + synthetic seeds)
fixtures/

# native build artifacts (anywhere in the tree)
*.whl
*.so
*.dylib
*.pyd
*.dll

# machine-local secrets / runtime env (never commit)
.config/
