# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Note: Cargo.lock is committed because this is an application, not a library
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# resource files
assets

# builds
# Note: build.rs SOURCE files are tracked. The `target/` and `debug/` rules above
# already exclude generated build artifacts; the previous bare `build.rs` pattern
# unintentionally hid actual build scripts (e.g. crates/thyllore-grpc-client/build.rs).

# cpp
src/cpp/

# editor
.idea/
.vscode/

# log
log/

# distribution packages
dist/

# lib
vendor/

# claude
.claude/settings.local.json
.claude/local/

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# python parity test fixtures (generated by cargo test)
crates/thyllore-ml-core/tests/python_parity/fixtures/

# Phase 3: Python venv for gRPC stub generation (created by scripts/gen_grpc_stubs.ps1)
.venv-grpc-tools/

# Phase 3: gRPC parity binary fixtures are vendored, but caches are not
blender_addon/tests/__pycache__/
blender_addon/grpc_client/__pycache__/
blender_addon/grpc_client/stubs/__pycache__/
